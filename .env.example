# Lane environment variables. Names only: never commit values.
# Real values live in the team's secret store and in Vercel or Agent Engine settings.
# Units may refine a name here if their code needs it; keep this file the single list.

# --- MongoDB Atlas (KTD2, U1 db.ts) ---
# Connection string for the Flex cluster. Required on Vercel (production and preview).
MONGODB_URI=
# Database name. Defaults to "lane" when unset.
MONGODB_DB=

# --- Operator controls (KTD16, U12) ---
# Long random passcode for /api/ops. Also keys the HMAC in the operator cookie.
OPS_PASSCODE=

# --- Agent Engine (KTD10, KTD11, U8) ---
# "cloud" (deployed workspaces) or "local" (agentengine dev up behind a tunnel).
AGENT_ENGINE_MODE=
# Agent Engine API base URL and project id for cloud mode.
AGENT_ENGINE_BASE_URL=
AGENT_ENGINE_PROJECT_ID=
# Service account with the Project Owner role (resume needs it).
AGENT_ENGINE_CLIENT_ID=
AGENT_ENGINE_CLIENT_SECRET=
# Public tunnel URL of the local agent server, used only in local mode (2:45 PM fallback).
AGENT_ENGINE_LOCAL_URL=
# "1" when the deployed agents cannot call Lane's internal API (no egress, U9). Rule-lab and the
# promoter then return their proposal, examples or decision, and the core applies them.
LANE_AGENT_NO_EGRESS=

# --- Internal agent API role keys (KTD9, KTD10, U9) ---
# Set on Vercel and as Agent Engine project secrets. Each role key opens only its own paths.
LANE_ROLE_KEY_RULE_LAB=
LANE_ROLE_KEY_PROMOTER=
# Lane's production base URL, used by Agent Engine agents to call /api/internal.
LANE_BASE_URL=

# --- LLM (U8) ---
# Model provider key used by the Agent Engine agents. Agent Engine secret, not needed on Vercel.
LLM_API_KEY=

# --- GitHub (KTD17, KTD21, U14) ---
# Server-side read token for the Ship Week verifier and handle checks.
GITHUB_VERIFIER_TOKEN=

# --- Scripted players (KTD17, U13). Local stage runner only, never on Vercel. ---
# Each player has its own GitHub login, write token and public sandbox repo (owner/name).
SAM_GITHUB_LOGIN=
SAM_GITHUB_TOKEN=
SAM_GITHUB_REPO=
GARY_GITHUB_LOGIN=
GARY_GITHUB_TOKEN=
GARY_GITHUB_REPO=
PRIYA_GITHUB_LOGIN=
PRIYA_GITHUB_TOKEN=
PRIYA_GITHUB_REPO=

# --- Vercel cron (KTD13, U18) ---
# Only if the plan tier allows a per-minute cron for /api/tick. Vercel sends it as a bearer token.
CRON_SECRET=

# --- Raindrop observability (KTD24, U20) ---
# Set on Vercel PRODUCTION ONLY. The free plan stops ingesting after 1,000 events a month.
# When unset, the Raindrop wrapper does nothing.
RAINDROP_WRITE_KEY=
