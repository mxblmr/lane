{
  "name": "lane-referee-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Lane referee: reviews one proof or one dispute when no rule decides (U8, KTD10)",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "main": "dist/referee_agent/main.js",
  "bin": {
    "lane-referee-agent": "dist/referee_agent/main.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --enable-source-maps dist/referee_agent/main.js",
    "dev": "tsx watch src/referee_agent/main.ts"
  },
  "dependencies": {
    "@mongodb-js/agent-engine-sdk": ">=0.11.3 <1",
    "@mongodb-js/agent-engine-runner-shared": ">=0.11.3 <1",
    "@mongodb-js/agent-engine-sdk-langgraph": ">=0.11.3 <1",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.7",
    "dotenv": "^16.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.16.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
