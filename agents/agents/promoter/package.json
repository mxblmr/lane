{
  "name": "lane-promoter-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Lane promoter: activates tested rules, with human approval for reject and hold_payout (U8, KTD10, R22)",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "main": "dist/promoter_agent/main.js",
  "bin": {
    "lane-promoter-agent": "dist/promoter_agent/main.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "start": "node --enable-source-maps dist/promoter_agent/main.js",
    "dev": "tsx watch src/promoter_agent/main.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@mongodb-js/agent-engine-sdk": ">=0.11.3 <1",
    "@mongodb-js/agent-engine-runner-shared": ">=0.11.3 <1",
    "@mongodb-js/agent-engine-sdk-langgraph": ">=0.11.3 <1",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.7",
    "dotenv": "^16.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.16.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
