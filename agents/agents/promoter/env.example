# Copy this file to .env before running `agentengine dev up` or `npm run dev`.
# Never commit real values. Deployed values are Agent Engine secrets.

# MongoDB connection string the SDK uses for checkpoints and traces.
# Leave empty for `agentengine dev up` (the local stack provides one).
MONGODB_URI=

# Database name the runtime uses for checkpoints and traces.
MDB_AGENTIC_STORE_DB=mdb_agentic_store

# LLM provider key. An Anthropic key (sk-ant-...) selects Claude; any other key selects OpenAI.
LLM_API_KEY=

# Lane's base URL and the promoter role key for /api/internal (KTD9).
LANE_BASE_URL=
LANE_ROLE_KEY_PROMOTER=

# Optional: HTTP port for the local server (defaults to 8000).
PORT=8000
